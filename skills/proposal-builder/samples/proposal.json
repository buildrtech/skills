    {
      "id": "precon",
      "tab": "Tab D",
      "kind": "narrative",
      "title": "Preconstruction approach",
      "answers": [
        "D"
      ],
      "lead": "The design is at schematic design. Our job before the GMP is to keep the $9.8 million budget visible at every step.",
      "items": [
        {
          "group": "Estimating and cost control",
          "text": "A detailed estimate at schematic design, design development, and 50% and 95% construction documents, each reconciled line by line to the one before so the County sees what moved and why.",
          "source": {
            "id": "lib-approach"
          }
        },
        {
          "group": "Estimating and cost control",
          "text": "Our estimates at schematic design have averaged within 3% of the final GMP on our last ten CM at Risk projects.",
          "source": {
            "id": "prior-2024",
            "page": 2
          }
        },
        {
          "group": "Value analysis",
          "text": "Value analysis runs alongside each estimate. Each idea goes to the County and Halverson Moen Architects with its cost, schedule, and maintenance effect, and nothing is carried until the County accepts it.",
          "source": {
            "id": "lib-approach"
          }
        },
        {
          "group": "Subcontractor procurement",
          "text": "Bid packages are released by trade with a pre-bid scope review. Bids are leveled on a common scope, and the leveling is shared with the County before award.",
          "source": {
            "id": "lib-approach"
          }
        }
      ]
    },
