          }
        },
        {
          "group": "Summary schedule",
          "text": "Construction start: May 2027, after the GMP amendment.",
          "source": {
            "id": "rfp",
            "page": 2,
            "section": "§2"
          }
        },
        {
          "group": "Summary schedule",
          "text": "Substantial Completion: no later than November 30, 2027, a seven-month build.",
          "source": {
            "id": "rfp",
            "page": 2,
            "section": "§2"
          }
        },
        {
          "group": "Keeping Riverside Park safe",
          "text": "Every work zone fenced and signed, deliveries routed outside peak park hours, and a weekly coordination call with County facility staff.",
          "source": {
